{
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": "npm install",
  "cleanUrls": false,
  "trailingSlash": false,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
